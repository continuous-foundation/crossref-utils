{
  "name": "crossref-utils",
  "version": "0.0.3",
  "license": "MIT",
  "description": "CLI for creating Crossref deposit metadata from MyST projects",
  "author": "Rowan Cockett <rowan@continuousfoundation.org>",
  "homepage": "https://github.com/continuous-foundation/crossref-utils",
  "type": "module",
  "bin": {
    "crossref": "dist/crossref.cjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "CrossRef",
    "DOI",
    "MyST",
    "CLI"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/continuous-foundation/crossref-utils.git",
    "directory": "packages/crossref-utils"
  },
  "scripts": {
    "copy:version": "echo \"const version = '\"$npm_package_version\"';\nexport default version;\" > src/version.ts",
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.ts*\" -c ../../.eslintrc.cjs",
    "build": "npm run clean && npm run copy:docs && npm run copy:version && esbuild src/index.ts --bundle --outfile=dist/crossref.cjs --platform=node --external:fsevents --external:xerces-wasm",
    "dev": "npm run copy:version && esbuild src/index.ts --bundle --outfile=dist/crossref.cjs --platform=node --external:fsevents --external:xerces-wasm --watch",
    "copy:docs": "cp ../../README.md ../../LICENSE .",
    "prepack": "npm run copy:docs"
  },
  "bugs": {
    "url": "https://github.com/continuous-foundation/crossref-utils/issues"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "doi-utils": "^2.0.5",
    "inquirer": "^9.2.23",
    "js-yaml": "^4.1.0",
    "myst-cli": "^1.3.25",
    "myst-cli-utils": "^2.0.11",
    "myst-common": "^1.7.10",
    "myst-frontmatter": "^1.7.10",
    "myst-to-jats": "^1.0.33",
    "node-fetch": "^3.3.2",
    "unist-builder": "^4.0.0",
    "uuid": "^10.0.0",
    "vfile": "^5.0.0",
    "xerces-wasm": "^2.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/inquirer": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.13",
    "@types/uuid": "^10.0.0",
    "crossref-utils-sdk": "0.0.3",
    "esbuild": "^0.20.0"
  }
}
